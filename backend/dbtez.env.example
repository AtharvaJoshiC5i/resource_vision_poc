# DBTEZ API integration: placeholders only. Never put real values in this file.
# Export these in your own shell (or your deployment's secret store). The code reads the process
# environment and never opens a .env file.

DBTEZ_BASE_URL=https://REPLACE-WITH-DBTEZ-HOST
DBTEZ_CLIENT_ID=REPLACE-WITH-CLIENT-ID
DBTEZ_CLIENT_SECRET=REPLACE-WITH-CLIENT-SECRET

DBTEZ_PROJECT_TRACK_OBJECT=REPLACE-WITH-PROJECT-TRACK-OBJECT-NAME
DBTEZ_ZINGHR_OBJECT=REPLACE-WITH-ZINGHR-OBJECT-NAME

# Optional tuning (defaults shown; maximums are the documented API limits)
# DBTEZ_TIMEOUT_SECONDS=30
# DBTEZ_PAGE_SIZE=5000
# DBTEZ_MAX_RETRIES=3
# DBTEZ_DATA_CALLS_PER_MINUTE=120
# DBTEZ_TOKEN_CALLS_PER_MINUTE=10

# Optional Project Track columns. These are NOT in the integration brief, so they are unset.
# Name a column only if the object really has it (confirm with the operator check).
# DBTEZ_PT_SUBPROJECT_COLUMN=
# DBTEZ_PT_OVERRIDE_COLUMN=
# DBTEZ_PT_CONTRACT_COLUMN=
# DBTEZ_PT_START_DATE_COLUMN=
# DBTEZ_PT_END_DATE_COLUMN=

# Limited sample (on by default so the dashboard renders quickly): first N rows of each month, first M months.
# Use 0 or off to load everything.
# DBTEZ_SAMPLE_ROWS_PER_MONTH=1000
# DBTEZ_SAMPLE_HR_ROWS=100   (first N ZingHR rows; 0 or off reads all, which matches more employees)
# DBTEZ_SAMPLE_MONTHS=6
