# Option A — full connection string (overrides server/database/user/password when set)
# AZURE_SQL_CONNECTION_STRING=Driver={ODBC Driver 18 for SQL Server};Server=tcp:your-server.database.windows.net,1433;Database=your-db;Uid=your-user;Pwd=your-password;Encrypt=yes;TrustServerCertificate=no;Connection Timeout=30;

# Option B — SQL Server authentication fields
AZURE_SQL_SERVER=resourcevisionfordev.database.windows.net
AZURE_SQL_DATABASE=dbforresourcevision
AZURE_SQL_USERNAME=Userresourcefordev
AZURE_SQL_PASSWORD=Resourcevision@2026

# ODBC driver installed on your machine (Windows often has Driver 18 or 17)
AZURE_SQL_DRIVER=ODBC Driver 18 for SQL Server

# Azure SQL TLS — set to yes if you see certificate errors in dev
AZURE_SQL_TRUST_SERVER_CERTIFICATE=no

# API
API_HOST=127.0.0.1
API_PORT=8000

# Optional row cap per table (0 = no limit)
AZURE_SQL_MAX_ROWS=0

# CORS — Vite dev server
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
